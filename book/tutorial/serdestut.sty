%% serdestut.sty -- house style for the Open-SERDES design tutorial (BRICD)
%% pdfLaTeX. Only packages that ship with TeX Live 2023+ (works locally and on Overleaf).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tutorial/serdestut}[2026/10/25 Open-SERDES tutorial style]

%% ---------- encoding & fonts ----------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[sc]{mathpazo}          % Palatino text + math
\RequirePackage[scaled=0.90]{helvet}       % Helvetica sans for headings, captions, boxes
\renewcommand{\ttdefault}{txtt}            % TX typewriter (scalable, ships with TeX Live)
\linespread{1.06}
\RequirePackage[protrusion=true,expansion=true]{microtype}

%% ---------- page geometry ----------
\RequirePackage[a4paper,top=24mm,bottom=26mm,left=24mm,right=24mm,headheight=22pt,headsep=9mm,footskip=11mm]{geometry}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em plus 0.2em minus 0.1em}
\raggedbottom

%% ---------- colour: BRICD palette ----------
\RequirePackage[dvipsnames,table]{xcolor}
\definecolor{navy}{HTML}{1B2A52}
\definecolor{bblue}{HTML}{2B5797}
\definecolor{gold}{HTML}{A8862E}
\definecolor{golddk}{HTML}{8A6A1C}
\definecolor{goldlt}{HTML}{E8C25E}
\definecolor{brown}{HTML}{7A5C14}
\definecolor{muted}{HTML}{5A6478}
\definecolor{pale}{HTML}{B8C4DD}
\definecolor{offwhite}{HTML}{F7F9FC}
\definecolor{bgpale}{HTML}{F1F4F9}
\definecolor{gridc}{HTML}{DFE6F0}
\definecolor{tile}{HTML}{FCFDFE}
\definecolor{tileline}{HTML}{E6D7A8}
\definecolor{btint}{HTML}{E4EBF6}
\definecolor{gtint}{HTML}{F5EDD8}
\definecolor{slate}{HTML}{34446A}
% accent colours for plots / schematics (match figsrc/bricdstyle.py)
\definecolor{c1}{HTML}{2B5797}  % series 1  blue
\definecolor{c2}{HTML}{C9822B}  % series 2  amber/gold
\definecolor{c3}{HTML}{2E8B74}  % series 3  teal-green
\definecolor{c4}{HTML}{B5473A}  % series 4  brick red (warnings, "bad")
\definecolor{c5}{HTML}{6B5CA5}  % series 5  violet
\definecolor{sigred}{HTML}{B5473A}
\definecolor{siggreen}{HTML}{2E8B74}

%% ---------- maths, units, tables ----------
\RequirePackage{amsmath,amssymb,mathtools,bm}
\RequirePackage[per-mode=symbol,detect-all,range-phrase={--},range-units=single,
  binary-units=true,group-minimum-digits=4]{siunitx}
\DeclareSIUnit\bit{b}
% Helvetica (T1) has no Omega glyph: always take Omega from the math font
\DeclareSIUnit\ohm{\ensuremath{\Omega}}
\providecommand{\Ohm}{\ensuremath{\Omega}}
\DeclareSIUnit\UIunit{UI}
\DeclareSIUnit\dBc{dBc}
\DeclareSIUnit\dBm{dBm}
\DeclareSIUnit\ppm{ppm}
\DeclareSIUnit\Vpp{V_{pp}}
\DeclareSIUnit\Vppd{V_{ppd}}
\DeclareSIUnit\mVpp{mV_{pp}}
\DeclareSIUnit\mVppd{mV_{ppd}}
\RequirePackage{booktabs,tabularx,multirow,makecell,array}
\renewcommand{\arraystretch}{1.18}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}

%% ---------- graphics ----------
\RequirePackage{graphicx}
\graphicspath{{tutorial/figs/}{tutorial/canva/}{figs/}{canva/}}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,positioning,shapes.geometric,shapes.misc,fit,backgrounds,
  decorations.pathreplacing,decorations.markings,patterns,shadows,matrix,chains,intersections}
% Pre-compiled TikZ figures: every tikzpicture is cached as a PDF in tutorial/tikzext/ so the
% book compiles fast (Overleaf free plan has a 10 s limit). After editing a figure it is redrawn
% when you delete its PDF in tutorial/tikzext/ (needs shell-escape, which Overleaf enables).
\usetikzlibrary{external}
\tikzexternalize[prefix=tutorial/tikzext/,up to date check=simple]

\RequirePackage[siunitx,RPvoltages,american inductors]{circuitikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage{tikz-timing}
\RequirePackage[font={small,sf},labelfont={bf,color=navy},labelsep=period,justification=raggedright,singlelinecheck=false]{caption}
\RequirePackage[font={small,sf}]{subcaption}
\RequirePackage{float}

% common TikZ styles for block diagrams (use these in every schematic/block figure)
\tikzset{
  >={Stealth[length=2.4mm]},
  blk/.style={draw=navy,line width=0.7pt,fill=tile,rounded corners=2pt,minimum height=9mm,
              minimum width=16mm,align=center,font=\sffamily\small,text=navy},
  blkb/.style={blk,fill=btint},           % blue-tinted block (analog)
  blkg/.style={blk,fill=gtint,draw=golddk},% gold-tinted block (digital / highlighted)
  blkn/.style={blk,fill=navy,text=white},  % solid navy block (emphasis)
  sig/.style={-{Stealth[length=2.2mm]},line width=0.75pt,draw=navy},
  sigb/.style={sig,draw=bblue},
  sigg/.style={sig,draw=golddk},
  clk/.style={-{Stealth[length=2.2mm]},line width=0.75pt,draw=gold,dashed},
  lbl/.style={font=\sffamily\scriptsize,text=muted},
  lblb/.style={font=\sffamily\footnotesize\bfseries,text=navy},
  dot/.style={circle,fill=navy,inner sep=0pt,minimum size=3.2pt},
  sumnode/.style={circle,draw=navy,line width=0.7pt,fill=tile,inner sep=0pt,minimum size=6mm,font=\small},
  region/.style={draw=pale,dashed,rounded corners=4pt,line width=0.6pt},
}
\ctikzset{bipoles/thickness=1.5, color=navy, monopoles/vcc/arrow={Stealth}}

%% ---------- lists ----------
\RequirePackage{enumitem}
\setlist{itemsep=0.15em,topsep=0.3em,parsep=0.1em,leftmargin=1.4em}
\setlist[itemize,1]{label={\color{gold}\small$\blacktriangleright$}}
\setlist[itemize,2]{label={\color{bblue}\textbullet}}

%% ---------- headings ----------
\RequirePackage{titlesec}
\RequirePackage{etoolbox}
\titleformat{\chapter}[display]
  {\normalfont\sffamily\color{navy}}
  {\tikzexternaldisable\begin{tikzpicture}[baseline]\node[fill=navy,text=goldlt,font=\sffamily\bfseries\Large,
     inner xsep=9pt,inner ysep=6pt,rounded corners=2pt] {\MakeUppercase{\chaptertitlename}\ \thechapter};\end{tikzpicture}\tikzexternalenable}
  {10pt}
  {\fontsize{27}{31}\selectfont\bfseries}
  [\vspace{4pt}{\color{gold}\titlerule[1.6pt]}]
\titleformat{name=\chapter,numberless}[display]
  {\normalfont\sffamily\color{navy}}{}{0pt}
  {\fontsize{27}{31}\selectfont\bfseries}[\vspace{4pt}{\color{gold}\titlerule[1.6pt]}]
\titlespacing*{\chapter}{0pt}{-6mm}{9mm}
\titleformat{\section}{\normalfont\sffamily\Large\bfseries\color{navy}}
  {\textcolor{gold}{\thesection}}{0.7em}{}
\titleformat{\subsection}{\normalfont\sffamily\large\bfseries\color{slate}}
  {\textcolor{gold}{\thesubsection}}{0.6em}{}
\titleformat{\subsubsection}{\normalfont\sffamily\normalsize\bfseries\color{slate}}{}{0em}{}
\titleformat{\paragraph}[runin]{\normalfont\sffamily\normalsize\bfseries\color{navy}}{}{0em}{}[.]
\titlespacing*{\section}{0pt}{1.6em plus 0.4em}{0.6em}
\titlespacing*{\subsection}{0pt}{1.2em plus 0.3em}{0.4em}
\titlespacing*{\subsubsection}{0pt}{1.0em plus 0.2em}{0.3em}
\titlespacing*{\paragraph}{0pt}{0.6em}{0.6em}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{1}

% Part pages: full navy page
\titleclass{\part}{top}
\titleformat{\part}[display]{\normalfont\sffamily}{}{0pt}{}
\newcommand{\partsubtitle}{}
\newcommand{\tutpart}[2]{% \tutpart{Title}{one-paragraph blurb}
  \cleardoublepage\thispagestyle{empty}%
  \refstepcounter{part}%
  \addcontentsline{toc}{part}{\protect\numberline{\thepart}#1}%
  \tikzexternaldisable\begin{tikzpicture}[remember picture,overlay]
    \fill[navy] (current page.south west) rectangle (current page.north east);
    \foreach \x in {0,1,...,21}{\draw[slate,line width=0.3pt] ($(current page.south west)+(\x*1cm,0)$) -- ++(0,30cm);}
    \foreach \y in {0,1,...,30}{\draw[slate,line width=0.3pt] ($(current page.south west)+(0,\y*1cm)$) -- ++(21cm,0);}
    \node[anchor=north west,text=goldlt,font=\sffamily\bfseries\Large] at ($(current page.north west)+(2.4cm,-6cm)$) {PART \thepart};
    \node[anchor=north west,text=white,font=\sffamily\bfseries\fontsize{38}{44}\selectfont,text width=15cm] at ($(current page.north west)+(2.4cm,-7.2cm)$) {#1};
    \draw[gold,line width=2pt] ($(current page.north west)+(2.4cm,-11.6cm)$) -- ++(4cm,0);
    \node[anchor=north west,text=pale,font=\sffamily\large,text width=14cm,align=left] at ($(current page.north west)+(2.4cm,-12.4cm)$) {#2};
  \end{tikzpicture}\tikzexternalenable%
  \clearpage}

%% ---------- headers & footers ----------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\chaptermark}[1]{\markboth{\if@mainmatter\thechapter.\ \fi #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\ #1}}
\fancyhead[L]{\sffamily\footnotesize\color{muted}\nouppercase{\leftmark}}
\fancyhead[R]{\sffamily\footnotesize\color{gold}\bfseries Open-SERDES Design Tutorial}
\fancyfoot[R]{\sffamily\small\bfseries\color{navy}\thepage}
\fancyfoot[L]{\sffamily\scriptsize\color{muted}BRICD \textperiodcentered{} thebricd.org}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{gridc}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[R]{\sffamily\small\bfseries\color{navy}\thepage}%
  \fancyfoot[L]{\sffamily\scriptsize\color{muted}BRICD \textperiodcentered{} thebricd.org}}

%% ---------- cross references, links ----------
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage[hidelinks,bookmarksnumbered,pdfusetitle]{hyperref}
\hypersetup{colorlinks=true,linkcolor=bblue,citecolor=golddk,urlcolor=bblue}
\RequirePackage[capitalise,noabbrev,nameinlink]{cleveref}
\crefname{lstlisting}{Listing}{Listings}
\crefname{part}{Part}{Parts}
\RequirePackage{url}

%% ---------- boxes ----------
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{breakable,skins,theorems,external}
\tcbset{shield externalize}   % keep box drawing out of the TikZ figure cache
\tcbset{tutbase/.style={enhanced,breakable,sharp corners=south,arc=2.5pt,boxrule=0pt,
  left=9pt,right=9pt,top=6pt,bottom=6pt,before skip=10pt,after skip=10pt,
  fonttitle=\sffamily\bfseries\small,coltitle=white,
  parbox=false,before upper={\setlength{\parskip}{0.45em}}}}

% Key equation: blue tint, navy left bar. Usage: \begin{keyeq}[optional title] ... \end{keyeq}
\newtcolorbox{keyeq}[1][]{tutbase,colback=btint,colframe=navy,
  borderline west={3pt}{0pt}{navy},
  attach boxed title to top left={xshift=9pt,yshift=-2.5mm},
  boxed title style={colback=navy,sharp corners,boxrule=0pt,top=1pt,bottom=1pt},
  title={\textsf{KEY EQUATION}\ifstrempty{#1}{}{\,\textperiodcentered\, #1}},top=10pt}

% Worked example: gold tint, numbered per chapter.
%   \begin{example}{Title}\label{we:key} ... \end{example}
\newcounter{wexample}[chapter]
\renewcommand{\thewexample}{\thechapter.\arabic{wexample}}
\crefname{wexample}{Worked Example}{Worked Examples}
\newtcolorbox{examplebox}[1]{tutbase,
  colback=gtint!70!white,colframe=golddk,
  borderline west={3pt}{0pt}{golddk},
  attach boxed title to top left={xshift=9pt,yshift=-2.5mm},
  boxed title style={colback=golddk,sharp corners,boxrule=0pt,top=1pt,bottom=1pt},
  title={WORKED EXAMPLE \thewexample\,\textperiodcentered\, #1},top=10pt}
\newenvironment{example}[1]{\refstepcounter{wexample}\begin{examplebox}{#1}}{\end{examplebox}}

% Design insight ("what this means for your design"): white with navy frame + gold title
\newtcolorbox{insight}[1][What this means for your design]{tutbase,colback=white,colframe=navy,
  boxrule=0.8pt,arc=3pt,sharp corners=downhill,
  title={\raisebox{-0.5pt}{\color{goldlt}$\blacktriangleright$}\ #1},colbacktitle=navy,
  fonttitle=\sffamily\bfseries\small}

% Common pitfall: brown accent
\newtcolorbox{pitfall}[1][Common pitfall]{tutbase,colback=white,colframe=brown,
  boxrule=0pt,borderline west={3pt}{0pt}{sigred},colback=sigred!5!white,
  title={\textsf{!}\ \ #1},colbacktitle=sigred,fonttitle=\sffamily\bfseries\small}

% Lab / try-it box (links to Chapter 16 code)
\newtcolorbox{tryit}[1][Try it in serdespy]{tutbase,colback=bgpale,colframe=slate,
  boxrule=0pt,borderline west={3pt}{0pt}{slate},
  title={\textsf{>\_}\ \ #1},colbacktitle=slate,fonttitle=\sffamily\bfseries\small}

% Chapter opener: objectives
\newtcolorbox{objectives}{enhanced,breakable,colback=bgpale,colframe=bgpale,arc=3pt,boxrule=0pt,
  left=10pt,right=10pt,top=8pt,bottom=8pt,before skip=4pt,after skip=12pt,
  borderline north={2pt}{0pt}{gold},parbox=false,
  fontupper=\sffamily\small,
  title={IN THIS CHAPTER YOU WILL LEARN},coltitle=golddk,colbacktitle=bgpale,
  fonttitle=\sffamily\bfseries\footnotesize,toptitle=2pt}

% Chapter closer: key takeaways
\newtcolorbox{takeaways}{enhanced,breakable,colback=navy,colframe=navy,arc=3pt,boxrule=0pt,
  left=11pt,right=11pt,top=9pt,bottom=9pt,before skip=14pt,coltext=white,parbox=false,
  fontupper=\sffamily\small,
  title={KEY TAKEAWAYS},coltitle=goldlt,colbacktitle=navy,fonttitle=\sffamily\bfseries\footnotesize,
  before upper={\setlist[itemize,1]{label={\color{goldlt}\small$\blacktriangleright$}}}}

% Derivation (optional, collapsible-looking grey box)
\newtcolorbox{derivation}[1][Derivation]{tutbase,colback=white,colframe=pale,boxrule=0.6pt,arc=2pt,
  sharp corners=south,title={#1},coltitle=slate,colbacktitle=bgpale,fonttitle=\sffamily\bfseries\small}

% "Open-SERDES spec" side note
\newtcolorbox{specnote}[1][Open-SERDES target]{tutbase,colback=gtint!45!white,colframe=gold,boxrule=0.6pt,arc=2pt,
  title={#1},coltitle=white,colbacktitle=gold,fonttitle=\sffamily\bfseries\small}

%% ---------- code listings ----------
\RequirePackage{listings}
\definecolor{codebg}{HTML}{F4F6FA}
\lstdefinestyle{tut}{language=Python,basicstyle=\ttfamily\footnotesize,
  backgroundcolor=\color{codebg},frame=leftline,framerule=2.5pt,rulecolor=\color{bblue},
  framesep=6pt,xleftmargin=9pt,
  keywordstyle=\color{bblue}\bfseries,commentstyle=\color{muted}\itshape,
  stringstyle=\color{golddk},numberstyle=\tiny\color{pale},numbers=none,
  showstringspaces=false,breaklines=true,breakatwhitespace=true,columns=fullflexible,keepspaces=true,
  upquote=true,aboveskip=8pt,belowskip=8pt,
  literate={–}{{--}}1 {—}{{---}}1 {≈}{{$\approx$}}1 {×}{{$\times$}}1 {µ}{{$\mu$}}1 {Ω}{{$\Omega$}}1 {σ}{{$\sigma$}}1}
