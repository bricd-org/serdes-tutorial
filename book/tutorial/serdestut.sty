\lstdefinestyle{shell}{style=tut,language=bash,rulecolor=\color{gold}}

%% ---------- notation macros (use these everywhere) ----------
\newcommand{\Tb}{T_\mathrm{b}}                 % bit period (= 1 UI)
\newcommand{\UI}{\mathrm{UI}}
\newcommand{\fN}{f_\mathrm{N}}                 % Nyquist frequency = 1/(2 Tb)
\newcommand{\fb}{f_\mathrm{b}}                 % bit rate
\newcommand{\BER}{\mathrm{BER}}
\newcommand{\SNR}{\mathrm{SNR}}
\newcommand{\Qf}{Q}                            % Gaussian tail function Q(x)
\newcommand{\dB}{\,\mathrm{dB}}
\newcommand{\ts}{t_\mathrm{s}}                 % sampling instant
\newcommand{\pk}[1]{p_{#1}}                    % pulse-response cursor p_k
\newcommand{\Hch}{H_\mathrm{ch}}               % channel transfer function
\newcommand{\Kvco}{K_\mathrm{VCO}}
\newcommand{\Icp}{I_\mathrm{CP}}
\newcommand{\Vdd}{V_\mathrm{DD}}
\newcommand{\Zo}{Z_0}
\newcommand{\gm}{g_\mathrm{m}}
\newcommand{\RL}{R_\mathrm{L}}
\newcommand{\CL}{C_\mathrm{L}}
\newcommand{\sigj}{\sigma_\mathrm{j}}
\newcommand{\sign}{\sigma_\mathrm{n}}
\newcommand{\ie}{i.e.,\ }
\newcommand{\eg}{e.g.,\ }
\newcommand{\sgn}{\operatorname{sgn}}
\newcommand{\erfc}{\operatorname{erfc}}
\newcommand{\Hctle}{H_\mathrm{CTLE}}
\newcommand{\code}[1]{\texttt{\small #1}}
\newcommand{\tool}[1]{\textsf{\bfseries\color{slate}#1}}   % tool names: \tool{ngspice}
\newcommand{\sgx}{SG13G2}
\newcommand{\OS}{Open-SERDES}
% margin-free "figure credit" line under captions
\newcommand{\figsrc}[1]{\par\vspace{-2pt}{\scriptsize\sffamily\color{muted}#1}}
% chapter epigraph-style one-liner
\newcommand{\chapterlead}[1]{{\large\color{slate}\itshape #1\par}\vspace{6pt}}

%% placeholders / todo (render visibly, so nothing slips through)
\newcommand{\TODO}[1]{\textcolor{sigred}{\sffamily\bfseries[TODO: #1]}}

